# CleanAir AI Configuration
# Backend Server Configuration
PORT=8000

# OpenAQ API Key (Get a free key from https://openaq.org)
# Leave blank to use Demo Data mode
OPENAQ_API_KEY="USE API KEY"

# Groq API Key (Get a free key from https://console.groq.com)
# Leave blank to use CleanAir AI local intelligent fallback assistant
GROQ_API_KEY="USE API KEY"
GROQ_MODEL=llama-3.3-70b-versatile
